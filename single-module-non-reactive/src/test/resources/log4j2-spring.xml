<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">

  <Properties>
    <Property name="PROJECT_VERSION">${spring:apps.version}</Property>
    <Property name="APP_NAME">${spring:spring.application.name}</Property>
    <Property name="LOG_PATH">${spring:logging.file.path}</Property>
    <Property name="LOG_STYLE">${spring:apps.log.log-format}</Property>
    <Property name="LOG_PATTERN_json">${spring:apps.log.json-pattern}</Property>
    <Property name="LOG_PATTERN_text">${spring:apps.log.text-pattern}</Property>
    <Property name="ACTIVE_LOG_PATTERN">${LOG_PATTERN_${LOG_STYLE:-json}}</Property>
    <Property name="ROOT_LOG_LEVEL">${spring:logging.level.root}</Property>
  </Properties>

  <Appenders>
    <Console
      name="consoleLog"
      target="SYSTEM_OUT"
    >
      <PatternLayout properties="true" stacktraceAsString="true">
        <pattern>${ACTIVE_LOG_PATTERN}</pattern>
      </PatternLayout>
    </Console>

    <RollingFile
      name="appLog"
      fileName="${LOG_PATH}/${APP_NAME}.log"
      filePattern="${LOG_PATH}/${APP_NAME}-%d{yyyy-MM-dd}.gz"
      immediateFlush="true"
    >
      <PatternLayout properties="true" stacktraceAsString="true">
        <pattern>${ACTIVE_LOG_PATTERN}</pattern>
      </PatternLayout>
      <Policies>
        <TimeBasedTriggeringPolicy
          interval="1"
          modulate="true"
        />
      </Policies>
      <DefaultRolloverStrategy max="1">
        <Delete basePath="${LOG_PATH}">
          <IfFileName glob="trace-*.log" />
          <IfLastModified age="P1D" />
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>

  </Appenders>

  <Loggers>
    <Root level="${ROOT_LOG_LEVEL}">
      <AppenderRef ref="consoleLog"/>
      <AppenderRef ref="appLog"/>
    </Root>
  </Loggers>
</Configuration>