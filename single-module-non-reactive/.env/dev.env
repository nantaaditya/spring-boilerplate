SERVER_PORT=8080
APPLICATION_NAME=example-app

DB_URL=jdbc:postgresql://host.docker.internal:5432/boilerplate
DB_USERNAME=user
DB_PASSWORD=password

LOG_PATH=/app/logs/

JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=60.0 -XX:MaxRAMPercentage=85.0 -XX:MinHeapFreeRatio=10 -XX:MaxHeapFreeRatio=60 -XX:InitiatingHeapOccupancyPercent=40 -XX:+UseCompressedOops -XX:+UseCompressedClassPointers -XX:+UseContainerSupport -XX:+UseG1GC -XX:+OptimizeStringConcat