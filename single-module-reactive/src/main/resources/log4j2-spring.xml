<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">

  <Properties>
    <Property name="PROJECT_VERSION">${spring:apps.version}</Property>
    <Property name="APP_NAME">${spring:spring.application.name}</Property>
    <Property name="LOG_PATH">${spring:logging.file.path}</Property>
    <Property name="JSON_LOG_PATTERN">{"timestamp":"%d{yyyy-MM-dd HH:mm:ss:SSS}", "level":"%level", "app_version":"${PROJECT_VERSION}", "class": "%logger{36}", "message":"%replace{%message}{[\r\n]+}{}. %replace{%xThrowable}{[\r\n]+}{|}", "trace_id":"%X{traceId}", "span_id":"%X{spanId}", "request_id":"%X{x-request-id}"}\n</Property>
    <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} --- [${APP_NAME:-}] [%-10thread] %-5level | requestId: [%X{x-request-id:-}] - trace: [%X{traceId:-}-%X{spanId:-}] | %logger{36} : %msg%n</Property>
    <Property name="ROOT_LOG_LEVEL">${spring:logging.level.root}</Property>
  </Properties>

  <Appenders>
    <Console
      name="jsonConsole"
      target="SYSTEM_OUT"
    >
      <PatternLayout>
        <pattern>${JSON_LOG_PATTERN}</pattern>
      </PatternLayout>
    </Console>

    <RollingFile
      name="appLog"
      fileName="${LOG_PATH}/${APP_NAME}.log"
      filePattern="${LOG_PATH}/${APP_NAME}-%d{yyyy-MM-dd}.log"
      immediateFlush="true"
    >
      <PatternLayout>
        <pattern>${JSON_LOG_PATTERN}</pattern>
      </PatternLayout>
      <Policies>
        <TimeBasedTriggeringPolicy
          interval="1"
          modulate="true"
        />
      </Policies>
       <DefaultRolloverStrategy max="7">
        <Delete basePath="${LOG_PATH}">
          <IfFileName glob="${APP_NAME}-*.log" />
          <IfLastModified age="P7D" />
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>

    <RollingFile
      name="metricsLog"
      fileName="${LOG_PATH}/metrics.log"
      filePattern="${LOG_PATH}/metrics-%d{yyyy-MM-dd}.log"
      immediateFlush="true"
    >
      <PatternLayout>
        <pattern>${LOG_PATTERN}</pattern>
      </PatternLayout>
      <Policies>
        <TimeBasedTriggeringPolicy
          interval="1"
          modulate="true"
        />
      </Policies>
      <DefaultRolloverStrategy max="1">
        <Delete basePath="${LOG_PATH}">
          <IfFileName glob="metrics-*.log" />
          <IfLastModified age="P1D" />
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>

    <RollingFile
      name="traceLog"
      fileName="${LOG_PATH}/trace.log"
      filePattern="${LOG_PATH}/trace-%d{yyyy-MM-dd}.log"
      immediateFlush="true"
    >
      <PatternLayout>
        <pattern>${LOG_PATTERN}</pattern>
      </PatternLayout>
      <Policies>
        <TimeBasedTriggeringPolicy
          interval="1"
          modulate="true"
        />
      </Policies>
      <DefaultRolloverStrategy max="1">
        <Delete basePath="${LOG_PATH}">
          <IfFileName glob="trace-*.log" />
          <IfLastModified age="P1D" />
        </Delete>
      </DefaultRolloverStrategy>
    </RollingFile>

  </Appenders>

  <Loggers>
    <Logger name="com.nantaaditya.example.listener.AppObservationListener" additivity="false">
      <AppenderRef ref="jsonConsole"/>
      <AppenderRef ref="metricsLog"/>
    </Logger>
    <Logger name="com.nantaaditya.example.configuration.TraceLogConfiguration" additivity="false">
      <AppenderRef ref="jsonConsole"/>
      <AppenderRef ref="traceLog"/>
    </Logger>
    <Root level="${ROOT_LOG_LEVEL}">
      <AppenderRef ref="jsonConsole"/>
      <AppenderRef ref="appLog"/>
    </Root>
  </Loggers>
</Configuration>